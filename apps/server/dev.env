# Окружение сервера в `pnpm dev`. Секретов здесь нет: база разработки из compose.yaml в корне,
# секрет входа годится только для разработки. Рабочие значения задаёт выкладка (deploy/README.md).
DATABASE_URL=postgres://lists:lists@127.0.0.1:5440/lists
AUTH_SECRET=dev-only-secret-not-for-production-0123456789
PUBLIC_URL=http://localhost:5175
HOST=127.0.0.1
PORT=3400
# X-Real-IP ставит только наш Caddy. Без него better-auth в режиме разработки молча считает
# клиента 127.0.0.1, а иначе пишет предупреждение, которое в бою значит, что Caddy не передал IP.
NODE_ENV=development
