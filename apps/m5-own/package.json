{
  "name": "m5-own",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build -c vite.ps.config.ts && vite build && node scripts/assemble.mjs",
    "build:server": "vite build -c vite.server.config.ts",
    "build:test": "TEST_PARAMS=1 vite build --outDir dist-test",
    "server:test": "DEV=1 node server/index.ts",
    "preview:test": "DIST=dist-test node server/preview.ts",
    "test": "playwright test",
    "check-types": "tsc --noEmit && tsc --noEmit --project tsconfig.sw.json"
  },
  "dependencies": {
    "@powersync/common": "2.3.1",
    "@powersync/shared-internals": "1.3.1",
    "@powersync/web": "2.4.2",
    "dexie": "4.4.4",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "workbox-precaching": "~7.4.1",
    "workbox-routing": "~7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "~1.3.0",
    "workbox-window": "~7.4.1"
  }
}
