:80 {
	root * /srv/current/site
	encode zstd gzip

	header X-Robots-Tag "noindex"

	log {
		output stdout
	}

	# Макет платформы данных: /admin/* (управление стендом тестов) снаружи закрыт, /api/* – сервер макета.
	handle /admin/* {
		respond 404
	}

	handle /api/* {
		header Cache-Control "no-store"
		# Пока пересоздаётся сервер при выкладке, Caddy держит запрос, а не отвечает 502
		reverse_proxy m5-server:13400 {
			lb_try_duration 15s
		}
	}

	handle {
		@revalidate not path /assets/* /ps/assets/*
		request_header @revalidate -If-None-Match
		request_header @revalidate -If-Modified-Since
		header @revalidate {
			Cache-Control "no-cache"
			-ETag
			-Last-Modified
		}
		@immutable path /assets/* /ps/assets/*
		header @immutable {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx
		}
		file_server
	}
}
