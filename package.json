{
  "name": "lists",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "pnpm test:unit && pnpm test:e2e",
    "check-types": "turbo check-types && tsc --project tsconfig.tests.json && tsc --project deploy/tsconfig.json",
    "storybook": "pnpm --filter watchlist storybook",
    "build-storybook": "turbo build-storybook",
    "check": "pnpm fmt:check && pnpm lint && pnpm check-types && pnpm build-storybook && pnpm test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:unit": "vitest run",
    "test:e2e": "turbo build build:next --output-logs=errors-only && playwright test",
    "prepare": "husky || true",
    "deploy:v2": "node deploy/command/index.ts",
    "rollback:v2": "node deploy/command/rollback-cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/node": "^24.19.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
